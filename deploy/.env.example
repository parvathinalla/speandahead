# Copy this to deploy/.env on your deployment server. Do not commit deploy/.env.
# Use DNS records pointing both names at this server.
APP_DOMAIN=app.YOUR-OWN-DOMAIN.com
API_DOMAIN=api.YOUR-OWN-DOMAIN.com

# Public Auth0 issuer/client identifiers (no client secret)
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_WEB_CLIENT_ID=YOUR_WEB_SPA_CLIENT_ID
AUTH0_AUDIENCE=https://api.creditpilot.example

# SERVER ONLY. Get the sandbox key from Nessie; never embed in Flutter.
NESSIE_API_KEY=REPLACE_WITH_PRIVATE_NESSIE_SANDBOX_KEY

# Optional Gemini explanatory service; numeric decisions never depend on it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
