FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /src
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .

# These compile-time values are PUBLIC identifiers; never put client secrets here.
ARG AUTH0_DOMAIN
ARG AUTH0_WEB_CLIENT_ID
ARG AUTH0_AUDIENCE
ARG API_BASE_URL
RUN test -n "$AUTH0_DOMAIN" && test -n "$AUTH0_WEB_CLIENT_ID" && \
    test -n "$AUTH0_AUDIENCE" && test -n "$API_BASE_URL"
RUN flutter build web --release \
    --dart-define=AUTH0_DOMAIN="$AUTH0_DOMAIN" \
    --dart-define=AUTH0_WEB_CLIENT_ID="$AUTH0_WEB_CLIENT_ID" \
    --dart-define=AUTH0_AUDIENCE="$AUTH0_AUDIENCE" \
    --dart-define=API_BASE_URL="$API_BASE_URL"

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html
EXPOSE 80
