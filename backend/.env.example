# CreditPilot private BACKEND config. Never commit backend/.env or real API keys.
APP_ENV=development

NESSIE_API_KEY=YOUR_PRIVATE_NESSIE_SANDBOX_KEY
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# Auth0 secure mode must be enabled before accepting real user signups.
# Use AUTH_MODE=demo ONLY for local fictional demos; APP_ENV=production forbids it.
AUTH_MODE=demo
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Authenticated users must be individually mapped by backend/scripts/link_user_sandbox.py.
# In production mount this directory as a protected server-only persistent volume.
# TENANT_MANIFEST_DIR=C:/private/creditpilot/tenants

# Sandbox transfers are disabled in production; no real banking transfer rails exist.
PAYMENT_MODE=simulate
NESSIE_TRANSFER_ALLOWED_SUB=

# Optional AI explanation (not needed for auth; do not put key into Flutter).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Development browsers on port 8080. For production use HTTPS origins only.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# SQLite is a local demo store. Production multi-instance needs a transactional DB.
# DB_PATH=C:/private/creditpilot/actions.sqlite3
