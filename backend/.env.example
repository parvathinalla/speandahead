# Keep this file public; put real secrets only into backend/.env locally.
NESSIE_API_KEY=YOUR_PRIVATE_NESSIE_SANDBOX_KEY
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# Demo mode uses FICTIONAL sandbox accounts only. Never deploy demo auth on public internet.
AUTH_MODE=demo
PAYMENT_MODE=simulate

# For real login validation, set AUTH_MODE=auth0 and fill the following:
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Comma-separated Auth0 "sub" values authorized for fictional seed accounts.
AUTH0_ALLOWED_SUBS=
JOINT_PARTNER_SUB=
# Only this verified Auth0 user can submit approved Nessie sandbox transfers.
NESSIE_TRANSFER_ALLOWED_SUB=

# Set PAYMENT_MODE=nessie only after Auth0 and sandbox transfer tests.
# Real credit-card payments and credit bureau reporting are NOT supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Flutter web local origin; add any exact deployment URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
