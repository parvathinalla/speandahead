# CreditPilot private BACKEND config. Never commit backend/.env or real API keys.
APP_ENV=development

NESSIE_API_KEY=YOUR_PRIVATE_NESSIE_SANDBOX_KEY
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# Auth0: configure a Database connection with username/password login and Disable Sign Ups.
# Admin creates each user in Auth0; CreditPilot never stores or verifies passwords.
# Use AUTH_MODE=demo ONLY for local fictional demos; APP_ENV=production forbids it.
AUTH_MODE=demo
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# For 500 Nessie accounts, link an existing Auth0 user using:
# python backend/scripts/link_nessie_user.py --subject "auth0|USER_ID" --slot 0
# Auth0 verifies username/password; TigerData stores hashed Auth0 user ID -> Nessie customer/account IDs.
# In production mount this directory as a protected server-only persistent volume.
# TENANT_MANIFEST_DIR=C:/private/creditpilot/tenants


# Finance data source:
# 'nessie': REAL Nessie API-backed fictional accounts, must be pre-provisioned.
# 'synthetic': 500 locally generated fictional demo profiles, NOT Nessie records.
# Existing Auth0 users default to synthetic unless explicitly overridden.
DEMO_DATA_MODE=nessie

# Base portfolio store (required only for DEMO_DATA_MODE=synthetic).
# DEMO_STORE=sqlite
# Set DEMO_STORE=tigerdata for synthetic profile persistence only;
# for Nessie + TigerData identity links, keep DEMO_STORE=sqlite.
DEMO_STORE=sqlite

# REQUIRED for Auth0 -> Nessie ID mapping, and optional for Gemini chat memory,
# available in EITHER Nessie or synthetic banking modes. Use only server .env,
# never Flutter or GitHub. TLS required (sslmode=verify-full recommended).
# TIGERDATA_DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require

# AI chat uses Gemini only for conversations; balances always come from selected
# authenticated banking data source. User memory is OFF unless opted in.
# Without TIGERDATA_DATABASE_URL, memory uses ignored local server SQLite.
# GEMINI_API_KEY=YOUR_PRIVATE_GEMINI_API_KEY

# Sandbox transfers are disabled in production; no real banking transfer rails exist.
PAYMENT_MODE=simulate
NESSIE_TRANSFER_ALLOWED_SUB=

# Optional AI explanation (not needed for auth; do not put key into Flutter).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Development browsers on port 8080. For production use HTTPS origins only.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# SQLite is a local demo store. Production multi-instance needs a transactional DB.
# DB_PATH=C:/private/creditpilot/actions.sqlite3
